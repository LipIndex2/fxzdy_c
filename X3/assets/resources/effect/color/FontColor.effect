// shader = 字体渐变
CCEffect %{
  techniques:
  - passes:
    - vert: sprite-vs:vert
      frag: sprite-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendDstAlpha: one_minus_src_alpha
      rasterizerState:
        cullMode: none
      properties:
        alphaThreshold: { value: 0.5 }
        color1: { value: [255.0, 0.0, 0.0, 1.0], editor: { type: color } }  
        color2: { value: [0.0, 128.0, 0.0, 1.0], editor: { type: color } }
        color3: { value: [0.0, 255.0, 0.0, 1.0], editor: { type: color } }
}%

CCProgram sprite-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>
  #endif
  #if SAMPLE_FROM_RT
    #include <common/common-define>
  #endif
  in vec3 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;

  out vec4 color;
  out vec2 uv0;

  vec4 vert () {
    vec4 pos = vec4(a_position, 1);

    #if USE_LOCAL
      pos = cc_matWorld * pos;
    #endif

    #if USE_PIXEL_ALIGNMENT
      pos = cc_matView * pos;
      pos.xyz = floor(pos.xyz);
      pos = cc_matProj * pos;
    #else
      pos = cc_matViewProj * pos;
    #endif

    uv0 = a_texCoord;
    #if SAMPLE_FROM_RT
      CC_HANDLE_RT_SAMPLE_FLIP(uv0);
    #endif
    color = a_color;

    return pos;
  }
}%

CCProgram sprite-fs %{
  precision highp float;
  #include <builtin/internal/embedded-alpha>
  #include <builtin/internal/alpha-test>

  in vec4 color;

  uniform Constants {
    vec4 color1;
    vec4 color2;
    vec4 color3;
  };

  #if USE_TEXTURE
    in vec2 uv0;
    #pragma builtin(local)
    layout(set = 2, binding = 12) uniform sampler2D cc_spriteTexture;
  #endif


  vec4 frag() {
    vec4 outColor = vec4(1.0, 1.0, 1.0, 1.0);

    #if USE_TEXTURE
      vec4 textureColor = CCSampleWithAlphaSeparated(cc_spriteTexture, uv0);
      outColor *= textureColor;
  
      outColor.rgb *= outColor.a;

    #if IS_GRAY
      float gray = 0.2126 * outColor.r + 0.7152 * outColor.g + 0.0722 * outColor.b;
      outColor.rgb = vec3(gray);
    #endif
    #endif

    vec3 gradientColor;
    float t;

    if (uv0.y < 0.2) {
      gradientColor = color1.rgb;
    } else if (uv0.y < 0.55) {
      t = (uv0.y - 0.2) / 0.55;
      gradientColor = mix(color1.rgb, color2.rgb, t);
    } else if (uv0.y < 0.6) {
      gradientColor = color2.rgb;
    } else if (uv0.y < 0.7) {
      t = (uv0.y - 0.6) / 0.2;
      gradientColor = mix(color2.rgb, color3.rgb, t);
    } else {
      gradientColor = color3.rgb;
    }

    // use
    outColor.rgb *= gradientColor;

    ALPHA_TEST(outColor);

    return outColor;
  }

}%
